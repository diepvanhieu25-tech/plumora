# Plumora Local & Test Environment Variables (Template — No Real Production Secrets)
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# PostgreSQL 16 (Single Source of Truth — Bound to 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=plumora_app
DB_PASSWORD=plumora_dev_pass_change_me
DB_NAME=plumora_dev
DATABASE_URL=postgresql+psycopg://plumora_app:plumora_dev_pass_change_me@127.0.0.1:5432/plumora_dev

# Redis 7 (Read/Write-through 24-dim State Cache — Bound to 127.0.0.1)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STATE_TTL_SECONDS=3600

# Authentication & Session Security (Leave empty in template; generated dynamically or set in .env.local)
JWT_SECRET_KEY=
SESSION_COOKIE_NAME=__Host-plumora_session

# RL Artifact Paths
RL_CHECKPOINT_PATH=rl/artifacts/gnn_ppo_v2_base.zip
RL_MANIFEST_PATH=rl/artifacts/manifest_phase3.json

# Optional External LLM Rubric Grader (OpenAI-compatible; leave key empty for offline deterministic fallback)
# Recommended with GCP Credits: link a GCP Project with Billing in Google AI Studio
PLUMORA_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
PLUMORA_LLM_API_KEY=
PLUMORA_LLM_MODEL=gemini-3.8-flash
